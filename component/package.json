{
  "name": "morph-bot-element",
  "version": "0.7.1",
  "description": "A framework-free SVG Drippy character Web Component with expressions, morphs, materials, audio-reactive speech and physical interaction.",
  "type": "module",
  "types": "./morph-bot.d.ts",
  "exports": {
    ".": {
      "types": "./morph-bot.d.ts",
      "import": "./morph-bot.js"
    },
    "./engine": "./grok-bot-engine.js",
    "./data": "./original-data.js",
    "./catalog": "./catalog.js",
    "./materials": {
      "types": "./materials.d.ts",
      "import": "./materials.js"
    },
    "./drippy-character": "./runtime/drippy-character.js",
    "./speech-meter": "./runtime/speech-meter.js",
    "./interaction": "./runtime/character-interaction.js"
  },
  "files": [
    "morph-bot.js",
    "grok-bot-engine.js",
    "original-data.js",
    "catalog.js",
    "materials.js",
    "materials.d.ts",
    "runtime",
    "morph-bot.d.ts",
    "README.md",
    "DRIPPY-COMPONENTS.md"
  ],
  "sideEffects": [
    "./morph-bot.js"
  ]
}
